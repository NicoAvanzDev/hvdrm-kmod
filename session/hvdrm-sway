#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
set -eu

fail() { echo "hvdrm-sway: $*" >&2; exit 1; }
[ "$(uname -s)" = FreeBSD ] || fail 'this session requires FreeBSD.'
[ "$(id -u)" -ne 0 ] || fail 'run from your local console as your regular user.'
command -v sway >/dev/null || fail 'Sway is missing; run sudo make install.'
command -v dbus-run-session >/dev/null || fail 'D-Bus is missing; run sudo make install.'

# FreeBSD's login PAM module normally supplies this directory.
private_runtime=
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    pam_runtime="/var/run/xdg/$(id -un)"
    if [ -d "$pam_runtime" ]; then
        XDG_RUNTIME_DIR=$pam_runtime
    else
        umask 077
        private_runtime=$(mktemp -d /tmp/hvdrm-runtime.XXXXXXXX)
        XDG_RUNTIME_DIR=$private_runtime
    fi
fi
cleanup() { if [ -n "$private_runtime" ]; then rm -rf -- "$private_runtime"; fi; }
trap cleanup EXIT
case $XDG_RUNTIME_DIR in /*) ;; *) fail 'the runtime directory must be an absolute path.' ;; esac
[ ! -L "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ] || fail 'the runtime directory is invalid.'
[ "$(stat -f '%u' "$XDG_RUNTIME_DIR")" = "$(id -u)" ] || fail 'the runtime directory belongs to another user.'
[ "$(stat -f '%Lp' "$XDG_RUNTIME_DIR")" = 700 ] || fail 'the runtime directory must have mode 0700.'
export XDG_RUNTIME_DIR

# The driver reports its actual card node; another GPU may occupy card0.
if [ -z "${WLR_DRM_DEVICES:-}" ]; then
    WLR_DRM_DEVICES=$(sysctl -n dev.hypervdrm.0.drm_device 2>/dev/null) ||
        fail 'the display driver is not loaded; reboot after installation or run sudo kldload hypervdrm.'
fi
[ -c "$WLR_DRM_DEVICES" ] || fail "display device $WLR_DRM_DEVICES is unavailable."
LIBSEAT_BACKEND=${LIBSEAT_BACKEND:-seatd}
if [ "$LIBSEAT_BACKEND" = seatd ] && [ ! -S "${SEATD_SOCK:-/var/run/seatd.sock}" ]; then
    fail 'seatd is not running; run sudo service seatd start.'
fi
WLR_BACKENDS=${WLR_BACKENDS:-drm,libinput}
WLR_RENDERER=${WLR_RENDERER:-pixman}
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=sway
export LIBSEAT_BACKEND WLR_BACKENDS WLR_RENDERER WLR_DRM_DEVICES
export XDG_SESSION_TYPE XDG_CURRENT_DESKTOP

# Keep compositor diagnostics off the VT framebuffer and retain them on exit.
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/hvdrm
umask 077
mkdir -p "$state_dir"
echo "Starting Sway; log: $state_dir/sway.log"
status=0
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    sway "$@" 2>"$state_dir/sway.log" || status=$?
else
    dbus-run-session -- sway "$@" 2>"$state_dir/sway.log" || status=$?
fi
[ "$status" -eq 0 ] || echo "hvdrm-sway: Sway exited with status $status; see $state_dir/sway.log" >&2
exit "$status"
